<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NetScan.Views.ScanPage"
             Title="Сканирование">
    <!--
      Страница сканирования использует две вертикальные области: верхняя
      отображает заголовок и результаты сканирования, а нижняя содержит
      кнопки управления и информационный текст. Результаты помещаются
      в ScrollView внутри StackLayout с именем "list".
    -->
    <StackLayout>
        <StackLayout Margin="30,20,30,30" VerticalOptions="StartAndExpand" Orientation="Vertical">                                                   <!-- Область заголовка и списка обнаруженных устройств -->
            <Label x:Name="title" FontSize="15" Margin="0,0,0,8" Text="{Binding SubnetText}" />                                                              <!-- Сканируемая подсеть -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"  IsVisible="{Binding IsBusy}" Margin="0,0,0,8" Color="#09f"/>                                                 <!-- Индикатор занятости -->
            <CollectionView ItemsSource="{Binding Devices}" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" SelectionMode="None">    <!-- Прокручиваемая область для фреймов устройств -->
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="6" Padding="10" CornerRadius="8" BorderColor="#E0E0E0" HorizontalOptions="Center" WidthRequest="350">
                            <StackLayout Orientation="Horizontal" Spacing="12">
                                <BoxView WidthRequest="18" HeightRequest="18" CornerRadius="9" Color="Green" VerticalOptions="Center"/>   <!-- индикатор доступности устройства -->
                                <StackLayout Orientation="Vertical">                                                                        <!-- вертикальная секция с hostname и ip -->
                                    <Label Text="{Binding Hostname}" FontAttributes="Bold" FontSize="14"/>
                                    <Label Text="{Binding Ip}" FontSize="14"/>
                                    <Label Text="{Binding ScanTime}" FontSize="Micro"/>
                                </StackLayout>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>

        <StackLayout Orientation="Vertical" VerticalOptions="EndAndExpand" Margin="0,0,0,30">
            <StackLayout x:Name="buttons" Orientation="Horizontal" HorizontalOptions="Center" Spacing="30">
                <Button Text="Сканировать" Padding="25,15" CornerRadius="50" Command="{Binding ScanCommand}" />
                <Button Text="Отменить" Padding="25,15" CornerRadius="50" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                <Button Text="Сохранить" Padding="25,15" CornerRadius="50" Command="{Binding SaveCommand}" IsVisible="{Binding ShowSave}" />
            </StackLayout>
        </StackLayout>
    </StackLayout>
</ContentPage>
